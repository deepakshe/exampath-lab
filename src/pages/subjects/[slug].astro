---
import BaseLayout from '../../layouts/BaseLayout.astro';
import subjects from '../../data/subjects.json';
import resources from '../../data/resources.json';

export async function getStaticPaths() {
  return subjects.map((subject) => ({
    params: { slug: subject.slug },
    props: { subject },
  }));
}

const { subject } = Astro.props;
const matchedResources = resources.filter((res) =>
  res.subjectId.toLowerCase() === subject.slug.toLowerCase() ||
  subject.id.toLowerCase().includes(res.subjectId.toLowerCase())
);
---

<BaseLayout
  title={`${subject.name_en} — ExamPath Lab`}
  description={subject.summary_en}
  breadcrumbs={[
    { label: 'Subjects', href: '/subjects/' },
    { label: subject.name_en }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Subject Header Banner -->
    <div class="rounded-2xl p-6 sm:p-10 bg-white border border-[#E2DDD1] shadow-sm mb-12">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-wider px-2.5 py-1 rounded" style={`background-color: ${subject.bg_color}; color: ${subject.color}; border: 1px solid ${subject.border_color};`}>
            {subject.name_en}
          </span>
          <h1 class="font-heading font-extrabold text-3xl sm:text-4xl text-[#172633] mt-3">
            <span data-lang="en">{subject.name_en}</span>
            <span data-lang="hi" class="hidden font-hindi">{subject.name_hi}</span>
          </h1>
          <div class="font-heading font-bold text-base text-[#147D78] mt-1">
            <span data-lang="en">{subject.tagline_en}</span>
            <span data-lang="hi" class="hidden font-hindi">{subject.tagline_hi}</span>
          </div>
          <p class="text-sm sm:text-base text-[#536471] mt-3 max-w-2xl leading-relaxed">
            <span data-lang="en">{subject.summary_en}</span>
            <span data-lang="hi" class="hidden font-hindi">{subject.summary_hi}</span>
          </p>
        </div>

        <div class="flex flex-col sm:flex-row md:flex-col gap-2 shrink-0">
          <a
            href={`/library/?subject=${subject.slug}`}
            class="px-5 py-2.5 rounded-lg bg-[#147D78] hover:bg-[#116662] text-white text-xs font-bold text-center transition-colors"
          >
            Filter Library for {subject.name_en} →
          </a>
          <a
            href="/practice/"
            class="px-5 py-2.5 rounded-lg border border-[#E2DDD1] bg-[#FAF8F3] hover:bg-[#ECE8DC] text-[#172633] text-xs font-bold text-center transition-colors"
          >
            Practice Recall Drills
          </a>
        </div>
      </div>

      <!-- Syllabus Topics -->
      <div class="mt-8 pt-6 border-t border-[#E2DDD1]">
        <div class="text-xs font-bold uppercase tracking-wider text-[#172633] mb-3">Syllabus Topic Modules:</div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
          {subject.topics.map((t) => (
            <div class="p-3 rounded-lg bg-[#FAF8F3] border border-[#E2DDD1] text-xs font-semibold text-[#172633] flex items-center gap-2">
              <span class="w-2 h-2 rounded-full" style={`background-color: ${subject.color}`}></span>
              <span>{t}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Active Guides in Subject -->
    <div class="mb-14">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="font-heading font-extrabold text-2xl text-[#172633]">
            Verified Learning Guides in {subject.name_en}
          </h2>
          <p class="text-xs text-[#536471] mt-0.5">Tested for mathematical accuracy and exam-appropriate speed.</p>
        </div>
        <span class="text-xs font-bold text-[#147D78] bg-[#E8F3F2] px-3 py-1 rounded-full">
          {matchedResources.length} Active Guides
        </span>
      </div>

      {matchedResources.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {matchedResources.map((res) => (
            <article class="editorial-card rounded-xl p-6 bg-white border border-[#E2DDD1] flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="field-badge text-[#147D78] border-[#147D78]/20 bg-[#E8F3F2]">
                    {res.level}
                  </span>
                  <span class="text-[11px] font-extrabold px-2 py-0.5 rounded bg-[#D7EF72]/40 text-[#172633]">
                    {res.access} Core
                  </span>
                </div>

                <h3 class="font-heading font-bold text-base text-[#172633] leading-snug">
                  <a href={`/library/${res.slug}/`} class="hover:text-[#147D78]">
                    <span data-lang="en">{res.title_en}</span>
                    <span data-lang="hi" class="hidden font-hindi">{res.title_hi}</span>
                  </a>
                </h3>

                <p class="text-xs text-[#536471] mt-2 line-clamp-3 leading-relaxed">
                  <span data-lang="en">{res.summary_en}</span>
                  <span data-lang="hi" class="hidden font-hindi">{res.summary_hi}</span>
                </p>

                <div class="mt-4 flex flex-wrap gap-1">
                  {res.examTags.map(tag => (
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-[#FAF8F3] border border-[#E2DDD1] text-[#536471]">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-[#E2DDD1] flex items-center justify-between text-xs text-[#536471]">
                <span>{res.estimatedMinutes} mins study</span>
                <a href={`/library/${res.slug}/`} class="font-bold text-[#147D78] hover:underline">
                  Open Guide →
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="p-8 rounded-xl bg-white border border-[#E2DDD1] text-center">
          <p class="text-sm text-[#536471]">Verified modules for {subject.name_en} are currently in editorial peer-review and will be added soon. We do not publish unverified AI content.</p>
        </div>
      )}
    </div>

  </div>
</BaseLayout>
