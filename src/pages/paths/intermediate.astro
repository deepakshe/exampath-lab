---
import BaseLayout from '../../layouts/BaseLayout.astro';
import learningPaths from '../../data/learning-paths.json';
import resources from '../../data/resources.json';

const path = learningPaths.find(p => p.slug === 'intermediate')!;
const matchedResources = resources.filter(r => path.curated_resources.includes(r.slug));
---

<BaseLayout
  title="02 — Intermediate Exam-Level Path | ExamPath Lab"
  description="Master exam shortcuts with verified conditions, compare standard vs speed techniques, and eliminate negative marking."
  breadcrumbs={[
    { label: 'Study Paths', href: '/paths/beginner/' },
    { label: '02 — Intermediate' }
  ]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Path Header -->
    <div class="rounded-2xl p-6 sm:p-10 bg-white border border-[#E2DDD1] shadow-sm mb-10">
      <div class="font-mono font-bold text-3xl text-[#2B4C7E] mb-2">{path.number}</div>
      <h1 class="font-heading font-extrabold text-3xl sm:text-4xl text-[#172633]">
        <span data-lang="en">{path.title_en}</span>
        <span data-lang="hi" class="hidden font-hindi">{path.title_hi}</span>
      </h1>
      <p class="font-heading font-semibold text-base text-[#2B4C7E] mt-2">
        <span data-lang="en">{path.subtitle_en}</span>
        <span data-lang="hi" class="hidden font-hindi">{path.subtitle_hi}</span>
      </p>

      <div class="mt-6 pt-6 border-t border-[#E2DDD1] space-y-2 text-xs text-[#172633]">
        <div class="font-bold uppercase tracking-wider text-[#536471]">Exam-Level Standards:</div>
        <ul class="space-y-1.5">
          {path.features_en.map((feat, idx) => (
            <li class="flex items-start gap-2">
              <span class="text-[#2B4C7E] font-bold">✓</span>
              <span data-lang="en">{feat}</span>
              <span data-lang="hi" class="hidden font-hindi">{path.features_hi[idx]}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Curated Intermediate Modules -->
    <div class="space-y-6 mb-12">
      <div class="flex items-center justify-between">
        <h2 class="font-heading font-extrabold text-2xl text-[#172633]">
          Speed & Trap Modules
        </h2>
        <span class="text-xs font-bold text-[#2B4C7E] bg-[#EDF3FA] px-3 py-1 rounded-full">
          Shortcuts with boundary conditions
        </span>
      </div>

      {matchedResources.map((res, stepIdx) => (
        <div class="editorial-card rounded-xl p-6 bg-white border border-[#E2DDD1] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-start gap-4">
            <span class="w-8 h-8 rounded-full bg-[#2B4C7E] text-white font-bold text-sm flex items-center justify-center shrink-0 mt-0.5">
              0{stepIdx + 1}
            </span>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#2B4C7E]">
                  {res.subjectName}
                </span>
                <span class="text-xs text-[#536471]">⏱ {res.estimatedMinutes} mins</span>
              </div>
              <h3 class="font-heading font-bold text-lg text-[#172633]">
                <a href={`/library/${res.slug}/`} class="hover:text-[#2B4C7E]">
                  <span data-lang="en">{res.title_en}</span>
                  <span data-lang="hi" class="hidden font-hindi">{res.title_hi}</span>
                </a>
              </h3>
              <p class="text-xs text-[#536471] mt-1.5 leading-relaxed line-clamp-2">
                <span data-lang="en">{res.summary_en}</span>
                <span data-lang="hi" class="hidden font-hindi">{res.summary_hi}</span>
              </p>
            </div>
          </div>

          <div class="shrink-0 sm:self-center">
            <a
              href={`/library/${res.slug}/`}
              class="px-4 py-2 rounded-lg bg-[#2B4C7E] hover:bg-[#1E3A5F] text-white text-xs font-bold inline-block text-center transition-colors"
            >
              Analyze Shortcuts →
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Navigation between paths -->
    <div class="flex items-center justify-between pt-6 border-t border-[#E2DDD1] text-xs font-bold">
      <a href="/paths/beginner/" class="text-[#536471] hover:underline flex items-center gap-1">
        ← Previous: 01 — Beginner Foundation
      </a>
      <a href="/paths/revision/" class="text-[#2B4C7E] hover:underline flex items-center gap-1">
        Next: 03 — Revision & Active Recall →
      </a>
    </div>

  </div>
</BaseLayout>
