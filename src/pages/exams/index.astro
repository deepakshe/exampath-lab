---
import BaseLayout from '../../layouts/BaseLayout.astro';
import exams from '../../data/exams.json';
---

<BaseLayout
  title="Exam Directories — ExamPath Lab"
  description="Explore government exam syllabi, active learning guides, and focused strategies for Banking, SSC, Railways, Defence, and State exams."
  breadcrumbs={[{ label: 'Exams' }]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-3xl mb-10">
      <span class="field-badge text-[#147D78] border-[#147D78]/20 bg-[#E8F3F2]">Taxonomy Hub</span>
      <h1 class="font-heading font-extrabold text-3xl sm:text-4xl text-[#172633] mt-2">
        Government Exam Directories
      </h1>
      <p class="text-sm sm:text-base text-[#536471] mt-2 leading-relaxed">
        We tag every concept, formula, and recall pack by exact exam relevance. Select your target exam to view syllabus breakdowns and active study resources.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {exams.map((exam) => (
        <div class="editorial-card rounded-2xl p-6 bg-white border border-[#E2DDD1] flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-[#FAF8F3] border border-[#E2DDD1] text-[#536471]">
                {exam.family}
              </span>
              <span class="text-xs font-extrabold text-[#147D78]">
                {exam.active_resources_count} Verified Guides
              </span>
            </div>

            <h2 class="font-heading font-extrabold text-2xl text-[#172633]">
              <a href={`/exams/${exam.slug}/`} class="hover:text-[#147D78] transition-colors">
                <span data-lang="en">{exam.name_en}</span>
                <span data-lang="hi" class="hidden font-hindi">{exam.name_hi}</span>
              </a>
            </h2>

            <p class="text-xs text-[#536471] mt-2 leading-relaxed">
              <span data-lang="en">{exam.summary_en}</span>
              <span data-lang="hi" class="hidden font-hindi">{exam.summary_hi}</span>
            </p>

            <div class="mt-4 pt-4 border-t border-[#E2DDD1]">
              <div class="text-[11px] font-bold uppercase tracking-wider text-[#172633] mb-1.5">Covered Examinations:</div>
              <div class="flex flex-wrap gap-1">
                {exam.exam_list.map((subExam) => (
                  <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-[#FAF8F3] text-[#536471] border border-[#E2DDD1]">
                    {subExam}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-4">
              <div class="text-[11px] font-bold uppercase tracking-wider text-[#147D78] mb-1.5">Priority Focus Areas:</div>
              <ul class="text-[11px] text-[#536471] space-y-1">
                {exam.key_focus_areas.map((area) => (
                  <li>• {area}</li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-[#E2DDD1]">
            <a
              href={`/exams/${exam.slug}/`}
              class="w-full py-2.5 rounded-lg bg-[#FAF8F3] hover:bg-[#E8F3F2] border border-[#E2DDD1] hover:border-[#147D78] text-[#172633] text-xs font-bold flex items-center justify-center gap-1 transition-colors"
            >
              Open {exam.name_en} Syllabus →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
