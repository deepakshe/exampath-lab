---
import BaseLayout from '../../layouts/BaseLayout.astro';
import exams from '../../data/exams.json';
import resources from '../../data/resources.json';

export async function getStaticPaths() {
  return exams.map((exam) => ({
    params: { slug: exam.slug },
    props: { exam },
  }));
}

const { exam } = Astro.props;
const matchedResources = resources.filter((res) =>
  res.examTags.some((tag) => tag.toLowerCase() === exam.slug.toLowerCase() || tag.toLowerCase() === exam.family.toLowerCase())
);
---

<BaseLayout
  title={`${exam.name_en} Preparation Hub — ExamPath Lab`}
  description={exam.summary_en}
  breadcrumbs={[
    { label: 'Exams', href: '/exams/' },
    { label: exam.name_en }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Exam Header Banner -->
    <div class="rounded-2xl p-6 sm:p-10 bg-white border border-[#E2DDD1] shadow-sm mb-12">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <span class="field-badge text-[#147D78] border-[#147D78]/20 bg-[#E8F3F2]">
            {exam.family} Category
          </span>
          <h1 class="font-heading font-extrabold text-3xl sm:text-4xl text-[#172633] mt-2">
            <span data-lang="en">{exam.name_en}</span>
            <span data-lang="hi" class="hidden font-hindi">{exam.name_hi}</span>
          </h1>
          <p class="text-sm sm:text-base text-[#536471] mt-3 max-w-2xl leading-relaxed">
            <span data-lang="en">{exam.summary_en}</span>
            <span data-lang="hi" class="hidden font-hindi">{exam.summary_hi}</span>
          </p>
        </div>

        <div class="flex flex-col sm:flex-row md:flex-col gap-2 shrink-0">
          <a
            href={`/library/?exam=${exam.slug}`}
            class="px-5 py-2.5 rounded-lg bg-[#147D78] hover:bg-[#116662] text-white text-xs font-bold text-center transition-colors"
          >
            Filter Library for {exam.name_en} →
          </a>
          <a
            href="/downloads/free/Common-Foundation-Challenge-Day1-3.html"
            target="_blank"
            class="px-5 py-2.5 rounded-lg border border-[#E2DDD1] bg-[#FAF8F3] hover:bg-[#ECE8DC] text-[#172633] text-xs font-bold text-center transition-colors"
          >
            Download Free Foundation Guide
          </a>
        </div>
      </div>

      <!-- Covered Exams Chips -->
      <div class="mt-6 pt-6 border-t border-[#E2DDD1] flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-[#172633]">Target Recruiter Tests:</span>
        {exam.exam_list.map((item) => (
          <span class="text-xs font-semibold px-2.5 py-1 rounded bg-[#FAF8F3] border border-[#E2DDD1] text-[#536471]">
            {item}
          </span>
        ))}
      </div>
    </div>

    <!-- Active Verified Study Resources -->
    <div class="mb-14">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="font-heading font-extrabold text-2xl text-[#172633]">
            Active Study Guides for {exam.name_en}
          </h2>
          <p class="text-xs text-[#536471] mt-0.5">Verified guides directly matched to this exam's testing format.</p>
        </div>
        <span class="text-xs font-bold text-[#147D78] bg-[#E8F3F2] px-3 py-1 rounded-full">
          {matchedResources.length} Resources Active
        </span>
      </div>

      {matchedResources.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {matchedResources.map((res) => (
            <article class="editorial-card rounded-xl p-6 bg-white border border-[#E2DDD1] flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="field-badge text-[#147D78] border-[#147D78]/20 bg-[#E8F3F2]">
                    {res.subjectName}
                  </span>
                  <span class="text-[11px] font-extrabold px-2 py-0.5 rounded bg-[#D7EF72]/40 text-[#172633]">
                    {res.access} Core
                  </span>
                </div>

                <h3 class="font-heading font-bold text-base text-[#172633] leading-snug">
                  <a href={`/library/${res.slug}/`} class="hover:text-[#147D78]">
                    <span data-lang="en">{res.title_en}</span>
                    <span data-lang="hi" class="hidden font-hindi">{res.title_hi}</span>
                  </a>
                </h3>

                <p class="text-xs text-[#536471] mt-2 line-clamp-3 leading-relaxed">
                  <span data-lang="en">{res.summary_en}</span>
                  <span data-lang="hi" class="hidden font-hindi">{res.summary_hi}</span>
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-[#E2DDD1] flex items-center justify-between text-xs text-[#536471]">
                <span>{res.estimatedMinutes} mins study</span>
                <a href={`/library/${res.slug}/`} class="font-bold text-[#147D78] hover:underline">
                  Open Guide →
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="p-8 rounded-xl bg-white border border-[#E2DDD1] text-center">
          <p class="text-sm text-[#536471]">Verified modules for this specific sub-category are currently in editorial peer-review. Explore the general library in the meantime.</p>
          <a href="/library/" class="mt-4 inline-block px-4 py-2 rounded bg-[#147D78] text-white text-xs font-bold">
            Go to Library →
          </a>
        </div>
      )}
    </div>

    <!-- Key Strategic Focus Areas -->
    <div class="rounded-xl p-6 sm:p-8 bg-[#FAF8F3] border border-[#E2DDD1]">
      <h3 class="font-heading font-extrabold text-xl text-[#172633] mb-4">
        Exam Blueprint & Core Preparation Rules
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {exam.key_focus_areas.map((rule, idx) => (
          <div class="p-4 rounded-lg bg-white border border-[#E2DDD1] flex items-start gap-3">
            <span class="w-5 h-5 rounded-full bg-[#147D78] text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">
              {idx + 1}
            </span>
            <div class="text-xs font-semibold text-[#172633] leading-relaxed">
              {rule}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
